{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run app",
      "detail": "Free ports → SQL Server → migrate + seed → API :8100 + web :3100. Ctrl-C stops everything.",
      "type": "shell",
      "command": "./scripts/dev.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      }
    },
    {
      "label": "Run API only",
      "detail": "Backend + database, no frontend.",
      "type": "shell",
      "command": "./scripts/dev.sh --no-web",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Free dev ports",
      "detail": "Kill node/python dev servers on 3000, 8000, 3100, 8100 (leaves Docker alone).",
      "type": "shell",
      "command": "lsof -nP -iTCP:3000 -iTCP:8000 -iTCP:3100 -iTCP:8100 -sTCP:LISTEN | awk 'NR>1 && ($1==\"node\" || $1 ~ /^[Pp]ython/ || $1==\"uvicorn\" || $1==\"next-ser\") {print $2}' | sort -u | xargs -r kill 2>/dev/null; echo 'Ports freed.'",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared", "close": true }
    },
    {
      "label": "Stop database",
      "detail": "Stop the local SQL Server container (data is kept in its volume).",
      "type": "shell",
      "command": "docker compose -f docker-compose.local-db.yml down",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared", "close": true }
    },
    {
      "label": "Test: backend",
      "detail": "pytest — simulator + API tests (no network, no SQL Server needed).",
      "type": "shell",
      "command": "uv run pytest -q",
      "options": { "cwd": "${workspaceFolder}/src" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Test: frontend typecheck + build",
      "type": "shell",
      "command": "npx tsc --noEmit && npx next build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "test",
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Usage: how's it doing (live)",
      "detail": "Last 7 days from the deployed API. Needs STATS_TOKEN in src/.env.",
      "type": "shell",
      "command": "uv run python -m scripts.usage_report --remote --days 7",
      "options": { "cwd": "${workspaceFolder}/src" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Usage: live, choose a window",
      "detail": "Same, over however many days you ask for (1–90).",
      "type": "shell",
      "command": "uv run python -m scripts.usage_report --remote --days ${input:usageDays}",
      "options": { "cwd": "${workspaceFolder}/src" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Usage: local database",
      "detail": "Reads DATABASE_URL directly — your dev data, not the live site.",
      "type": "shell",
      "command": "uv run python -m scripts.usage_report --days 7",
      "options": { "cwd": "${workspaceFolder}/src" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Demo: print the Born answer table",
      "detail": "Runs the simulator on the fixture route and prints time-vs-speed.",
      "type": "shell",
      "command": "uv run python -m scripts.demo_sim",
      "options": { "cwd": "${workspaceFolder}/src" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ],
  "inputs": [
    {
      "id": "usageDays",
      "type": "promptString",
      "description": "How many days back? (1–90)",
      "default": "30"
    }
  ]
}
