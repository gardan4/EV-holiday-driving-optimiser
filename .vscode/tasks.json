{
  // Ordered by how often you actually reach for them. Two prefixes only:
  // "Mission control" for the dashboard, "Usage" for the production numbers
  // you cannot get locally.
  //
  // ⇧⌘B → Run app.  ⇧⌘P → "Tasks: Run Task" → everything else.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run app",
      "detail": "Free ports → SQL Server → migrate + seed → API :8100 + web :3100. Ctrl-C stops everything.",
      "type": "shell",
      "command": "./scripts/dev.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      }
    },
    {
      "label": "Run API only",
      "detail": "Backend + database, no frontend.",
      "type": "shell",
      "command": "./scripts/dev.sh --no-web",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Mission control",
      "detail": "The live dashboard on :8101 — builds the UI if needed, waits for the DB, opens the browser. Reads your LOCAL database. Sign in with STATS_TOKEN from .env. Ctrl-C stops it.",
      "type": "shell",
      "command": "./scripts/dashboard.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      }
    },
    {
      "label": "Mission control: deployed database",
      "detail": "The same console on :8102, reading the DEPLOYED database — real trips, real people. Read-only: the dashboard role serves no route that writes. Needs DATABASE_URL_PROD in .env and a SQL firewall rule for your IP (docs/DEPLOYMENT.md). A separate port so a local tab and a live one can sit open together; the filter bar says which is which.",
      "type": "shell",
      "command": "./scripts/dashboard.sh --prod",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      }
    },
    {
      "label": "Mission control: rebuild the UI",
      "detail": "After editing dashboard/. Recompiles into src/dashboard_static without starting the server. (For hot reload instead: npm --prefix dashboard run dev.)",
      "type": "shell",
      "command": "./scripts/dashboard.sh --build-only",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Usage: production numbers",
      "detail": "The live site's numbers as a terminal table, read through the API's token-gated stats route — so unlike the deployed-database console it needs no firewall rule and works from anywhere. Needs STATS_TOKEN in .env.",
      "type": "shell",
      "command": "uv run python -m scripts.usage_report --remote --days 7",
      "options": { "cwd": "${workspaceFolder}/src" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Usage: production snapshot",
      "detail": "Same production numbers as a single self-contained HTML file, opened in your browser — no server, mailable, keeps working offline.",
      "type": "shell",
      "command": "uv run python -m scripts.usage_dashboard --remote --days 30",
      "options": { "cwd": "${workspaceFolder}/src" },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared", "close": true }
    },
    {
      "label": "Test: backend",
      "detail": "pytest — simulator + API tests (no network, no SQL Server needed).",
      "type": "shell",
      "command": "uv run pytest -q",
      "options": { "cwd": "${workspaceFolder}/src" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Test: frontend typecheck + build",
      "type": "shell",
      "command": "npx tsc --noEmit && npx next build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "test",
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Free dev ports",
      "detail": "Kill node/python dev servers on 3000, 8000, 3100, 8100, 8101, 8102 (leaves Docker alone).",
      "type": "shell",
      "command": "lsof -nP -iTCP:3000 -iTCP:8000 -iTCP:3100 -iTCP:8100 -iTCP:8101 -iTCP:8102 -sTCP:LISTEN | awk 'NR>1 && ($1==\"node\" || $1 ~ /^[Pp]ython/ || $1==\"uvicorn\" || $1==\"next-ser\") {print $2}' | sort -u | xargs -r kill 2>/dev/null; echo 'Ports freed.'",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared", "close": true }
    },
    {
      "label": "Stop database",
      "detail": "Stop the local SQL Server container (data is kept in its volume).",
      "type": "shell",
      "command": "docker compose -f docker-compose.local-db.yml down",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared", "close": true }
    },
    {
      "label": "Demo: print the Born answer table",
      "detail": "Runs the simulator on the fixture route and prints time-vs-speed.",
      "type": "shell",
      "command": "uv run python -m scripts.demo_sim",
      "options": { "cwd": "${workspaceFolder}/src" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ]
}
