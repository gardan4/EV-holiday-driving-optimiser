# Build artifacts
.specstory/

# The admin dashboard's compiled bundle. Built by CI into the API image (and by
# `npm --prefix dashboard run build` locally) — committing it would mean the
# repo carries a minified copy of dashboard/src that goes stale the moment
# anyone edits the source.
src/dashboard_static/

.claude/
claude-code-main
