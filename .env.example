# EV Trip Optimizer — environment configuration
#
# Copy to `.env` (init.sh does this and generates the two secrets for you) and
# fill in the TODOs. The backend reads this file (src/app/core/config.py); the
# frontend reads NEXT_PUBLIC_* from frontend/.env.local (see the bottom block).

# ── Runtime ──────────────────────────────────────────────────────────────────
ENV=development                 # development | production
EXPOSE_DOCS=true                # Swagger at /docs. Default is off — never set this in a deployed app.
PROCESS_ROLE=all                # web | worker | all  (skeleton has no workers → all)

# ── Secrets (generated per-clone by init.sh — do NOT reuse across projects) ──
# SECRET_KEY:     python -c "import secrets; print(secrets.token_urlsafe(32))"
# ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
ENCRYPTION_KEY=

# ── Database — Azure SQL (MSSQL) ─────────────────────────────────────────────
# Local dev points at the docker-compose SQL Server (docker-compose.local-db.yml):
DATABASE_URL=mssql+aioodbc://sa:LocalDev_Passw0rd!@localhost:14330/evtripdb-dev?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
# In Azure, CI/Bicep injects the real connection string.
#
# The DEPLOYED database, read by `./scripts/dashboard.sh --prod` (VS Code:
# "Mission control: deployed database") and by nothing else. Left empty that
# mode refuses to start, which is the intended default — this line is the only
# thing on a laptop that can reach live user data.
#
# Use a READ-ONLY login, not the SQL admin. The console never writes, but the
# credential is what enforces that rather than the promise; run this once
# against the deployed database as admin:
#
#   CREATE USER dashboard_ro WITH PASSWORD = '…';
#   ALTER ROLE db_datareader ADD MEMBER dashboard_ro;
#   -- no db_datawriter, no db_ddladmin: a SELECT is all the console does
#
# Your IP also needs a SQL firewall rule (infra `devAllowedIps`,
# docs/DEPLOYMENT.md) — Azure SQL admits the App Service outbound set and
# nothing else, so without one the login just times out.
DATABASE_URL_PROD=

# ── External data providers (free API keys; server-side only) ────────────────
# ORS: https://openrouteservice.org/dev/  (routing + geocoding)
# OCM: https://openchargemap.org/site/develop/api  (charger locations)
# Not needed until you plan real trips — vehicles/simulator work without them.
ORS_API_KEY=
OCM_API_KEY=

# ── CORS / URLs ──────────────────────────────────────────────────────────────
CORS_ORIGINS=*                  # comma-separated allowlist in production; "*" is dev-only
FRONTEND_URL=http://localhost:3100
API_PUBLIC_URL=http://localhost:8100

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false                  # false = human-readable dev output

# ── Optional: Azure AI Foundry (inert — nothing in the skeleton calls it) ────
# Fill these and add a client in a service to wire an LLM feature.
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=

# ── Frontend (put these in frontend/.env.local, NOT here) ────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8100
# NEXT_PUBLIC_SITE_URL=http://localhost:3100
