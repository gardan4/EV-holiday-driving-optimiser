# EV Trip Optimizer — environment configuration
#
# Copy to `.env` (init.sh does this and generates the two secrets for you) and
# fill in the TODOs. The backend reads this file (src/app/core/config.py); the
# frontend reads NEXT_PUBLIC_* from frontend/.env.local (see the bottom block).

# ── Runtime ──────────────────────────────────────────────────────────────────
ENV=development                 # development | production
PROCESS_ROLE=all                # web | worker | all  (skeleton has no workers → all)

# ── Secrets (generated per-clone by init.sh — do NOT reuse across projects) ──
# SECRET_KEY:     python -c "import secrets; print(secrets.token_urlsafe(32))"
# ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
ENCRYPTION_KEY=

# ── Database — Azure SQL (MSSQL) ─────────────────────────────────────────────
# Local dev points at the docker-compose SQL Server (docker-compose.local-db.yml):
DATABASE_URL=mssql+aioodbc://sa:LocalDev_Passw0rd!@localhost:1433/evtripdb-dev?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
# In Azure, CI/Bicep injects the real connection string.

# ── Authentication — Clerk (REQUIRED; the app will not render without it) ─────
# Create a Clerk application, then:
#   Dashboard → API Keys → copy the publishable + secret keys and the JWT public key.
#   Dashboard → Sessions → "Customize session token" → add claims:
#     { "email": "{{user.primary_email_address}}", "name": "{{user.full_name}}", "email_verified": "{{user.email_verified}}" }
CLERK_PUBLISHABLE_KEY=          # pk_test_... / pk_live_...
CLERK_SECRET_KEY=               # sk_test_... / sk_live_...
CLERK_JWT_KEY=                  # PEM public key (single line, with literal \n escapes)
CLERK_ISSUER=                   # e.g. https://clerk.evtrip.app or https://xxx.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=       # comma-separated frontend origins (e.g. http://localhost:3000)
CLERK_WEBHOOK_SECRET=           # whsec_... (only needed for the user.deleted webhook)

# ── CORS / URLs ──────────────────────────────────────────────────────────────
CORS_ORIGINS=*                  # comma-separated allowlist in production; "*" is dev-only
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false                  # false = human-readable dev output

# ── Optional: Azure AI Foundry (inert — nothing in the skeleton calls it) ────
# Fill these and add a client in a service to wire an LLM feature.
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=

# ── Frontend (put these in frontend/.env.local, NOT here) ────────────────────
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
